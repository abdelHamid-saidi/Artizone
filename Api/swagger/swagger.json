              }
            }
          }
        }
      },
      "post": {
        "tags": ["Disponibilite"],
        "summary": "Créer une nouvelle disponibilité",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Disponibilite" }
            }
          }
        },
        "responses": {
          "201": { "description": "Disponibilité créée avec succès" },
          "400": { "description": "Erreur de validation" }
        }
      }
    },
    "/disponibilites/{id}": {
      "get": {
        "tags": ["Disponibilite"],
        "summary": "Récupérer une disponibilité par ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Disponibilité trouvée",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Disponibilite" }
              }
            }
          },
          "404": { "description": "Disponibilité non trouvée" }
        }
      },
      "put": {
        "tags": ["Disponibilite"],
        "summary": "Mettre à jour une disponibilité",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Disponibilite" }
            }
          }
        },
        "responses": {
          "200": { "description": "Disponibilité mise à jour" },
          "404": { "description": "Disponibilité non trouvée" }
        }
      },
      "delete": {
        "tags": ["Disponibilite"],
        "summary": "Supprimer une disponibilité",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": { "description": "Disponibilité supprimée" },
          "404": { "description": "Disponibilité non trouvée" }
        }
      }
    },
    "/commandes": {
      "get": {
        "tags": ["Commande"],
        "summary": "Récupérer toutes les commandes",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Liste des commandes",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Commande" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Commande"],
        "summary": "Créer une nouvelle commande",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Commande" }
            }
          }
        },
        "responses": {
          "201": { "description": "Commande créée avec succès" },
