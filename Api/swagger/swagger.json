            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Commande" }
              }
            }
          },
          "404": { "description": "Commande non trouvée" }
        }
      },
      "put": {
        "tags": ["Commande"],
        "summary": "Mettre à jour une commande",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Commande" }
            }
          }
        },
        "responses": {
          "200": { "description": "Commande mise à jour" },
