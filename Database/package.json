{
  "name": "artizone-database",
  "version": "1.0.0",
  "description": "Base de données pour le projet Artizone",
  "main": "models/index.js",
  "scripts": {
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdelHamid-saidi/Artizone.git"
  },
  "keywords": [
    "database",
    "sequelize",
    "mysql",
    "artizone"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/abdelHamid-saidi/Artizone/issues"
  },
  "homepage": "https://github.com/abdelHamid-saidi/Artizone#readme",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "mysql2": "^3.14.1",
    "sequelize": "^6.37.7",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.3"
  }
}
